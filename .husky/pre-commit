#!/bin/sh
# ============================================================================
# pre-commit — 秒単位 / staged スコープ / 自動修正
#   責務: コミットを綺麗に保つ + 秘密情報を履歴に入れない
#   ここに置かないもの: 全テスト / smoke / build / coverage → pre-push
#
#   目標: 通常 2-4s。ただし lint-staged 内の `vitest related` は
#   src/lib/db/index.ts のような広く import されるファイルを触ると
#   tests/db/ 配下を丸ごと引くため、db/schema 系の変更時は 10s+ になり得る
#   （既存設定であり、これ自体は退行ではない）。
# ============================================================================
set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

# pnpm ラッパーは 1 呼び出し約 0.52s。oxlint 本体 0.22s の 7 倍になるため
# ローカル bin を直接叩く。フラグは package.json の scripts と一致させること
# （CI は package.json 経由で走るので、乖離があれば CI 側で顕在化する）。
PATH="$ROOT/node_modules/.bin:$PATH"
export PATH

# --- 1. 自動修正 + staged スコープ検証 --------------------------------------
# oxfmt --write / secretlint / vitest related を staged ファイルにのみ適用。
# lint-staged が unstaged 変更を退避し、修正結果を自動で再ステージするので
# 整形差分が「次のコミット」に漏れない。
# oxlint/tsgo より先に走らせる（旧実装は lint:fast → tsgo → lint-staged の順で、
# oxfmt --write が最後に走るため整形後の内容が一度も静的検査されていなかった）。
#
# 注意: lint-staged は自動修正した内容をこの時点で index に再ステージ済み。
# そのため直後の oxlint/tsgo が落ちてコミットが中断されても、整形結果は
# 作業ツリー・index の両方に残る（旧順序では静的検査が落ちれば作業ツリーは
# 無傷だった）。実害はほぼないが、"検査が落ちた == 何も変わっていない" では
# ない点を意識すること。
lint-staged

# --- 2. リポジトリ全体の静的ゲート（整形後の内容に対して） ------------------
# oxlint 0.22s / tsgo 0.55s。並列化しても数十 ms しか縮まないので逐次のまま。
oxlint --nextjs-plugin --react-plugin --react-perf-plugin
tsgo --noEmit

# --- 3. 非ブロッキング advisory ---------------------------------------------
# spec.md 更新漏れの検出（staged ファイルが spec-sensitive かどうか）。
bash scripts/check-spec-update.sh

# src/ に staged されなかった変更が残っていないか（コミット漏れ検知）。
# pre-push には「未コミット変更ガード」しかなく HEAD 型検査は行わないため、
# ここで気づけないと push まで気づけない。
if [ -n "$(git diff --name-only -- src)" ]; then
  printf '\n[warn] src/ に未ステージの変更があります。コミット漏れに注意してください。\n\n'
fi

# package.json と pnpm-lock.yaml は依存変更時に必ず対で入れる。
# 片方だけ staged だと pre-push の lockfile-sync（frozen-lockfile）で落ちる。
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
HAS_PKG=0
HAS_LOCK=0
if printf '%s\n' "$STAGED" | grep -qx 'package.json';   then HAS_PKG=1;  fi
if printf '%s\n' "$STAGED" | grep -qx 'pnpm-lock.yaml'; then HAS_LOCK=1; fi
if [ $((HAS_PKG + HAS_LOCK)) -eq 1 ]; then
  printf '\n[warn] package.json と pnpm-lock.yaml の片方だけが staged です。\n'
  printf '       依存を変更したら両方を同じコミットに含めてください。\n'
  printf '       pre-push の lockfile-sync で blocking 検証されます。\n\n'
fi

exit 0
