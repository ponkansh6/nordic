# Turso Database (https://turso.tech)
TURSO_DATABASE_URL=libsql://your-database-username.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Google Gemini API (https://aistudio.google.com/app/apikey)
# Used for article scoring (gemini-3.1-flash-lite) and embeddings (gemini-embedding-2).
GOOGLE_API_KEY=your-google-api-key

# Page Authentication (Basic Auth for /bookmarks and /admin/db)
# The news list (/) stays public.
# Leave empty to disable those pages in production (503).
# In development, they are accessible without authentication.
# ADMIN_BASIC_AUTH_USER=admin
# ADMIN_BASIC_AUTH_PASSWORD=your-secure-password
